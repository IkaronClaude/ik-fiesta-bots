<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <RootNamespace>Fiesta.Bot.Host</RootNamespace>
    <!-- The Web SDK defaults to Server GC, which sizes gen0 for throughput and lets RSS ride up near the
         heap hard limit on purpose. This host is 4 low-throughput socket sessions in a 1-CPU / 512Mi
         container, where that costs an OOMKill (2026-08-18) rather than buying anything. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="7.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fiesta.Bot\Fiesta.Bot.csproj" />
  </ItemGroup>

  <!-- Served pages are embedded resources, NOT wwwroot: StaticWebAssetsEnabled is false above, and
       embedding compiles them into the assembly so they ship in the image with no publish/copy step.
       Keeping them as real .html files (rather than C# string literals) preserves editor tooling and
       diffs, and avoids any """ collision with raw-string delimiters. -->
  <ItemGroup>
    <EmbeddedResource Include="Pages\watch.html" LogicalName="Fiesta.Bot.Host.Pages.watch.html" />
  </ItemGroup>

</Project>
