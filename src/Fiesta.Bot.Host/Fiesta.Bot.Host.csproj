<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- WORKSTATION GC, MEASURED (2026-10-05). The Web SDK defaults to Server GC; with the pod's 2-core limit that is two
         heaps with a gen0 budget of hundreds of MB, so gen0 ran rarely and each run marked a huge MoonSharp object graph:
         the Lua tick profiler logged gc=518ms/1/0/0 (ONE gen0 collection, 518 ms) on a tick that allocated 1.2 MB, and
         every bot's tick stalls with it (NewMage at tickMs=50 ran 300-960 ms ticks). Workstation concurrent GC collects
         gen0 small and often (single-digit ms) - the right trade for a 20 Hz tick loop; throughput is not the goal. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <RootNamespace>Fiesta.Bot.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="7.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fiesta.Bot\Fiesta.Bot.csproj" />
  </ItemGroup>

  <!-- Served pages are embedded resources, NOT wwwroot: StaticWebAssetsEnabled is false above, and
       embedding compiles them into the assembly so they ship in the image with no publish/copy step.
       Keeping them as real .html files (rather than C# string literals) preserves editor tooling and
       diffs, and avoids any """ collision with raw-string delimiters. -->
  <ItemGroup>
    <EmbeddedResource Include="Pages\watch.html" LogicalName="Fiesta.Bot.Host.Pages.watch.html" />
  </ItemGroup>

</Project>
